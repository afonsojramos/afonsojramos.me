{
  "name": "afonsojramos.me",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "contributions:update": "node scripts/update-contributions.ts",
    "db:migrate:local": "wrangler d1 migrations apply afonsojramos-me-views --local",
    "dev": "pnpm run db:migrate:local && astro dev",
    "dev:network": "pnpm run db:migrate:local && astro dev --host",
    "build": "astro build && node scripts/rasterize-covers.ts",
    "preview": "wrangler pages dev ./dist --port 4321",
    "preview:network": "astro preview --host",
    "lint": "oxlint",
    "music:images": "node scripts/sync-music-images.ts",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.5",
    "@astrojs/markdown-satteri": "0.3.8",
    "@astrojs/mdx": "7.0.8",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/solid-js": "7.0.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@kobalte/core": "^0.13.13",
    "@kobalte/tailwindcss": "^0.9.0",
    "@markdoc/markdoc": "^0.5.9",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.2.8",
    "blockrate": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-solid": "^8.6.0",
    "hono": "^4.13.5",
    "husky": "^9.1.7",
    "sharp": "^0.35.4",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@resvg/resvg-js": "^2.6.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "wawoff2": "^2.0.1",
    "wrangler": "4.127.0"
  },
  "packageManager": "pnpm@12.1.0",
  "auditConfig": {
    "ignoreGhsas": [
      "GHSA-f88m-g3jw-g9cj",
      "1124066"
    ]
  }
}
