---
import { cn } from "~/lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  simple?: boolean;
  class?: string;
};

const { href, external, underline = true, simple = false, class: className, ...rest } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  class={cn(
    "inline-flex",
    !simple &&
      "text-current hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out",
    className
  )}
  {...rest}
>
  {
    underline ? (
      <span>
        <span class="link-line">
          <slot />
        </span>
      </span>
    ) : (
      <slot />
    )
  }
</a>
